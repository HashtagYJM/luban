# Company-specific client provider — NEVER commit
luban/client_local.py

# User-owned custom tools — lives in ~/.luban/, never commit a copy
tools_local.py

# Internal design docs / plans — kept locally, not published
docs/superpowers/

# Subagent-driven-development scratch (task briefs, reports, review diffs,
# ledger) — internal, may reference internal identifiers; NEVER publish
.superpowers/

# Local design + navigation notes — may reference internal details, never publish.
# CLAUDE/AGENTS/LUBAN are all three project-memory filenames luban itself looks for,
# so a copy under any of them can't be accidentally committed.
CLAUDE.md
AGENTS.md
LUBAN.md
# The internal design map. It wikilinks into docs/superpowers/, and some spec
# filenames there carry internal identifiers — publishing it would leak them.
ARCHITECTURE.md

# Local scratch (screenshots, corporate error logs) — never publish
_local/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
.env
.pytest_cache/
*.egg-info/
